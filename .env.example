# AutoDyn environment variables. Copy to .env.local for local builds; set in Vercel for deployments.
# Never commit real values. The app runs fully without any of these (AI features are then disabled).

# --- Gemini (AI Build Assistant, optional) -----------------------------------------------------
# Server-side only. Create the key in Google AI Studio in a project WITHOUT billing enabled so
# usage can never be charged (free tier only; quota errors are handled gracefully).
GEMINI_API_KEY=
# Model id exactly as listed at ai.google.dev/gemini-api/docs/models (no quotes, no "models/").
# gemini-3.5-flash-lite: stable, structured output, free tier (verified 2026-10).
GEMINI_MODEL=gemini-3.5-flash-lite
# Used once if the configured model is not found/unsupported for the project ("none" disables).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional secret (>=16 chars) enabling the quota-consuming generation probe and model listing.
# Without it, /api/assistant/health?probe=1 only verifies key + model via metadata (no generation):
#   curl -H "Authorization: Bearer $AI_DIAGNOSTICS_TOKEN" "https://<preview>/api/assistant/health?probe=1&models=1"
AI_DIAGNOSTICS_TOKEN=
# Optional ceiling for any single answer (includes thinking tokens). Each request asks only for its
# depth budget (1024 brief / 2048 standard / 4096 detailed); leave unset to use 4096. Provider timeout in ms.
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=20000

# --- Rate limiting ---------------------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=40
AI_GLOBAL_DAILY_LIMIT=300
# Optional persistent limiter shared across serverless instances (Upstash Redis REST, free tier).
# Without these, limits are tracked per server instance only (best-effort, not global).
# Check which one a deployment runs: GET /api/assistant → "rateLimiter": { "backend": "upstash" | "memory" }.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
