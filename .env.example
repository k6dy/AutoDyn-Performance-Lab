# AutoDyn environment variables. Copy to .env.local for local builds; set in Vercel for deployments.
# Never commit real values. The app runs fully without any of these (AI features are then disabled).

# --- Gemini (AI Build Assistant, optional) -----------------------------------------------------
# Server-side only. Create the key in Google AI Studio in a project WITHOUT billing enabled so
# usage can never be charged (free tier only; quota errors are handled gracefully).
GEMINI_API_KEY=
# Defaults to gemini-3.5-flash-lite (free tier available at the time of writing).
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request output cap (includes thinking tokens) and provider timeout.
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=15000

# --- Rate limiting ---------------------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=40
AI_GLOBAL_DAILY_LIMIT=300
# Optional persistent limiter shared across serverless instances (Upstash Redis REST, free tier).
# Without these, limits are tracked per server instance only (best-effort, not global).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
